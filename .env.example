# AgentShield Environment Configuration
ENV=dev
DATABASE_URL=sqlite:///./agentshield.db
DEFAULT_API_KEY=agentshield-dev-key-12345
ADMIN_TOKEN=agentshield-admin-supersecret-token-2026

# ---------------------------------------------------------------------------------------
# Live external API integrations (ALL OPTIONAL)
# ---------------------------------------------------------------------------------------
# AgentShield runs end-to-end with zero keys. Any provider below that is left unset falls
# back to a high-fidelity local simulation that is explicitly labelled "simulated" in the
# API response, on the telemetry span, and as a badge on the dashboard — a simulated call
# is never presented as a real one.
#
# Check what is real vs simulated at any time:
#   curl -H "X-API-Key: $DEFAULT_API_KEY" http://127.0.0.1:8000/live-agent/providers
#
# Master switch. Set to false to disable ALL outbound egress (hermetic demos / CI).
LIVE_ALLOW_NETWORK=true
LIVE_HTTP_TIMEOUT_SECONDS=6.0

# --- Public APIs: no key required (GitHub, Open-Meteo, Hacker News, urlscan.io search) ---

# --- LLM providers: enable real inference with real token counts and dollar costs ---
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Enterprise tool APIs ---
# Stripe key enables real PaymentIntent creation (test mode moves no money).
STRIPE_API_KEY=

# Communication APIs: payloads are PII-redacted BEFORE dispatch, keyed or not.
SENDGRID_API_KEY=
SLACK_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: raises the urlscan.io rate limit. Works unauthenticated at a lower rate.
URLSCAN_API_KEY=
